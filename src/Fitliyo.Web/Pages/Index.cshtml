@page
@model Fitliyo.Web.Pages.IndexModel
@using System.Globalization
@using System.Text.Json

<div class="row g-3 mb-2">
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Toplam Kullanıcı</div>
                <div class="display-6 fw-bold">@Model.Stats.TotalUsers</div>
                <div class="text-muted small">Aktif Eğitmen: @Model.Stats.TotalTrainers</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Toplam Paket</div>
                <div class="display-6 fw-bold">@Model.Stats.TotalPackages</div>
                <div class="text-muted small">Toplam Abonelik: @Model.Stats.TotalSubscriptions</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Bu Ay Sipariş</div>
                <div class="display-6 fw-bold">@Model.Stats.MonthlyOrderCount</div>
                <div class="text-muted small">Toplam Sipariş: @Model.Stats.TotalOrders</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card h-100 border-success-subtle">
            <div class="card-body">
                <div class="text-muted small">Bu Ay Ciro</div>
                <div class="display-6 fw-bold text-success">@Model.Stats.MonthlyRevenue.ToString("N0", CultureInfo.GetCultureInfo("tr-TR")) ₺</div>
                <div class="text-muted small">Bekleyen Çekim: @Model.Stats.PendingWithdrawals</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-xl-8">
        <div class="card h-100">
            <div class="card-header border-0 pb-0">
                <h5 class="mb-0">Sipariş ve Ciro Trendi (Son 6 Ay)</h5>
            </div>
            <div class="card-body">
                <div style="position: relative; height: 340px;">
                    <canvas id="ordersTrendChart"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-4">
        <div class="card h-100">
            <div class="card-header border-0 pb-0">
                <h5 class="mb-0">Aktif Paket Dağılımı</h5>
            </div>
            <div class="card-body">
                <div style="position: relative; height: 280px;">
                    <canvas id="packageTypeChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-12">
        <div class="card">
            <div class="card-header border-0 pb-0">
                <h5 class="mb-0">Hızlı Özet</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <div class="p-3 bg-light rounded">
                            <div class="text-muted small">Toplam Değerlendirme</div>
                            <div class="h4 mb-0">@Model.Stats.TotalReviews</div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="p-3 bg-light rounded">
                            <div class="text-muted small">Toplam Abonelik Planı</div>
                            <div class="h4 mb-0">@Model.Stats.TotalSubscriptionPlans</div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="p-3 bg-light rounded">
                            <div class="text-muted small">Bekleyen Para Çekme</div>
                            <div class="h4 mb-0 text-warning">@Model.Stats.PendingWithdrawals</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        (() => {
            const labels = @Html.Raw(JsonSerializer.Serialize(Model.MonthlyLabels));
            const orderCounts = @Html.Raw(JsonSerializer.Serialize(Model.MonthlyOrderCounts));
            const monthlyRevenue = @Html.Raw(JsonSerializer.Serialize(Model.MonthlyRevenue));
            const packageTypeLabels = @Html.Raw(JsonSerializer.Serialize(Model.PackageTypeLabels));
            const packageTypeCounts = @Html.Raw(JsonSerializer.Serialize(Model.PackageTypeCounts));

            const orderCtx = document.getElementById("ordersTrendChart");
            if (orderCtx) {
                new Chart(orderCtx, {
                    type: "bar",
                    data: {
                        labels,
                        datasets: [
                            {
                                type: "bar",
                                label: "Sipariş",
                                data: orderCounts,
                                borderRadius: 6,
                                backgroundColor: "rgba(54, 162, 235, 0.45)",
                                borderColor: "rgba(54, 162, 235, 1)",
                                borderWidth: 1
                            },
                            {
                                type: "line",
                                label: "Ciro (₺)",
                                data: monthlyRevenue,
                                yAxisID: "y1",
                                borderColor: "rgba(75, 192, 192, 1)",
                                backgroundColor: "rgba(75, 192, 192, 0.2)",
                                tension: 0.35
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: { beginAtZero: true, title: { display: true, text: "Sipariş Adedi" } },
                            y1: { beginAtZero: true, position: "right", grid: { drawOnChartArea: false }, title: { display: true, text: "Ciro (₺)" } }
                        }
                    }
                });
            }

            const packageCtx = document.getElementById("packageTypeChart");
            if (packageCtx) {
                new Chart(packageCtx, {
                    type: "doughnut",
                    data: {
                        labels: packageTypeLabels,
                        datasets: [{
                            data: packageTypeCounts,
                            backgroundColor: ["#4e79a7", "#f28e2b", "#e15759", "#76b7b2", "#59a14f"]
                        }]
                    },
                    options: { responsive: true, maintainAspectRatio: false }
                });
            }
        })();
    </script>
}
